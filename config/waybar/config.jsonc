// ┌──────────────────────────────────────────────────────┐
// │  Waybar Configuration — Obsidian Glow               │
// │  Glassmorphic top bar for Hyprland                   │
// └──────────────────────────────────────────────────────┘
{
    // ── General ──────────────────────────────────────────
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,
    "icon-size": 16,

    // ── Module layout ────────────────────────────────────
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/media",
        "pulseaudio",
        "network",
        "backlight",
        "battery"
    ],

    // ── Hyprland Workspaces ──────────────────────────────
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "󰲠",
            "2": "󰲢",
            "3": "󰲤",
            "4": "󰲦",
            "5": "󰲨",
            "active": "󰮯",
            "default": "󰊠",
            "urgent": "󰗖"
        },
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        },
        "sort-by-number": true
    },

    // ── Hyprland Window ──────────────────────────────────
    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - Visual Studio Code": "󰨞  $1",
            "(.*)": "  $1"
        }
    },

    // ── Clock ────────────────────────────────────────────
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %B %d, %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#a855f7'><b>{}</b></span>",
                "days": "<span color='#e4e4e7'>{}</span>",
                "weeks": "<span color='#06b6d4'>W{}</span>",
                "weekdays": "<span color='#a1a1aa'><b>{}</b></span>",
                "today": "<span color='#06b6d4'><b><u>{}</u></b></span>"
            }
        }
    },

    // ── Tray ─────────────────────────────────────────────
    "tray": {
        "icon-size": 16,
        "spacing": 10,
        "show-passive-items": true
    },

    // ── Custom Media (playerctl) ─────────────────────────
    "custom/media": {
        "format": "{}",
        "escape": true,
        "max-length": 35,
        "exec": "playerctl -p feishin,firefox,%any metadata --format '{{ title }} — {{ artist }}' 2>/dev/null || echo ''",
        "interval": 2,
        "on-click": "playerctl -p feishin,firefox,%any play-pause",
        "on-scroll-up": "playerctl -p feishin,firefox,%any next",
        "on-scroll-down": "playerctl -p feishin,firefox,%any previous",
        "tooltip": false
    },

    // ── PulseAudio ───────────────────────────────────────
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󱡏",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{desc}\n{volume}%"
    },

    // ── Network ──────────────────────────────────────────
    "network": {
        "format-wifi": "{icon}  {essid}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤭  disconnected",
        "format-linked": "󰈁  {ifname} (no IP)",
        "tooltip-format": "  {ifname}\n  {ipaddr}/{cidr}\n󱑽  {gwaddr}\n󰕒  {bandwidthUpBits}\n󰇚  {bandwidthDownBits}",
        "tooltip-format-wifi": "󰤨  {essid} ({signalStrength}%)\n  {ifname}\n  {ipaddr}/{cidr}\n󰕒  {bandwidthUpBits}\n󰇚  {bandwidthDownBits}",
        "tooltip-format-disconnected": "󰤭  No connection",
        "max-length": 20,
        "on-click": "kitty --class float-nmtui -e nmtui"
    },

    // ── Battery ──────────────────────────────────────────
    "battery": {
        "states": {
            "full": 100,
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-full": "󰁹  full",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{capacity}% — {power:.1f}W",
        "interval": 10
    },

    // ── Backlight ────────────────────────────────────────
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness: {percent}%",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    }
}
