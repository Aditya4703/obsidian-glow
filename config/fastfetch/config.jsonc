{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": "  ",
        "color": {
            "keys": "magenta",
            "output": "white"
        }
    },
    "logo": {
        "type": "small",
        "color": {
            "1": "magenta",
            "2": "cyan"
        },
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
            "key": " "
        },
        {
            "type": "separator",
            "string": "─────────────────────────"
        },
        {
            "type": "os",
            "key": "  OS",
            "format": "{pretty-name} {arch}"
        },
        {
            "type": "kernel",
            "key": "  Kernel"
        },
        {
            "type": "packages",
            "key": "  Pkgs"
        },
        {
            "type": "shell",
            "key": "  Shell"
        },
        {
            "type": "wm",
            "key": "  WM"
        },
        {
            "type": "terminal",
            "key": "  Term"
        },
        {
            "type": "terminalfont",
            "key": "  Font"
        },
        {
            "type": "cpu",
            "key": "  CPU",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": " 󰢮 GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": " 󰍛 RAM",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "key": " 󰋊 Disk",
            "folders": "/"
        },
        {
            "type": "uptime",
            "key": " 󰅐 Up"
        },
        {
            "type": "separator",
            "string": "─────────────────────────"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
